<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="Watermark"
        Arguments=""
        InstallLocation="C:\Program Files\Kezlo98\Watermark">
    </Installer>
    <PackageInformation
        PackageName="Watermark"
        PackageDisplayName="Watermark"
        PublisherName="CN=Kezlo98"
        PublisherDisplayName="Kezlo98"
        Version="1.3.0.0"
        PackageDescription="Kafka Desktop Client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.wails.Watermark"
                Description="Kafka Desktop Client"
                DisplayName="Watermark"
                ExecutableName="Watermark"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Watermark</DisplayName>
            <PublisherDisplayName>Kezlo98</PublisherDisplayName>
            <Description>Kafka Desktop Client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="watermark.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
